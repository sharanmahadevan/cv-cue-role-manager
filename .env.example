# Copy to .env for local runs. On Fly these are secrets (see fly.toml).

# Demo mode: serve built-in sample role profiles instead of a real CV-CUE (ignored on Fly)
CVCUE_MOCK=true
# Developer sign-in button for local use (always off on Fly)
DEV_LOGIN=true

# Real CV-CUE (set CVCUE_MOCK=false). Base URL: CV-CUE → System → Advanced Settings → Base URLs for APIs
CVCUE_BASE_URL=
CVCUE_KEY_ID=
CVCUE_KEY_VALUE=
# Location whose subtree is managed (0 = root)
CVCUE_ROOT_LOCATION=0

# Sign-in
PUBLIC_URL=http://localhost:8080
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma list of addresses or @domains allowed to sign in
ALLOWED_EMAILS=
